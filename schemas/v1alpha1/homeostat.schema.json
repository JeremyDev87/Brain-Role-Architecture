{
  "$id": "https://brain-role.dev/schemas/v1alpha1/homeostat.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "brain-role.dev/v1alpha1"
    },
    "kind": {
      "const": "HomeostatManifest"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "const": "PUBLIC"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "type": "string"
        },
        "version": {
          "pattern": "^0\\.2\\.[0-9]+$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "classification"
      ],
      "type": "object"
    },
    "spec": {
      "additionalProperties": false,
      "properties": {
        "aboveLevel": {
          "type": "number"
        },
        "belowLevel": {
          "type": "number"
        },
        "metric": {
          "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$",
          "type": "string"
        },
        "normalLevel": {
          "type": "number"
        },
        "regulatorRef": {
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "type": "string"
        },
        "targetRange": {
          "additionalProperties": false,
          "properties": {
            "max": {
              "type": "number"
            },
            "min": {
              "type": "number"
            }
          },
          "required": [
            "min",
            "max"
          ],
          "type": "object"
        }
      },
      "required": [
        "metric",
        "targetRange",
        "regulatorRef",
        "belowLevel",
        "normalLevel",
        "aboveLevel"
      ],
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "type": "object"
}
