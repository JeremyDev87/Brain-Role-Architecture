{
  "$id": "https://brain-role.dev/schemas/v1alpha1/receptor-binding.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "brain-role.dev/v1alpha1"
    },
    "kind": {
      "const": "ReceptorBinding"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "const": "PUBLIC"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "type": "string"
        },
        "version": {
          "pattern": "^0\\.2\\.[0-9]+$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "classification"
      ],
      "type": "object"
    },
    "spec": {
      "additionalProperties": false,
      "properties": {
        "effects": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "max": {
                "type": "number"
              },
              "min": {
                "type": "number"
              },
              "operation": {
                "enum": [
                  "add",
                  "multiply"
                ]
              },
              "parameter": {
                "enum": [
                  "activationThreshold",
                  "signalGain"
                ]
              },
              "value": {
                "type": "number"
              }
            },
            "required": [
              "parameter",
              "operation",
              "value",
              "min",
              "max"
            ],
            "type": "object"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array"
        },
        "regulatorRef": {
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "type": "string"
        },
        "targetNeuron": {
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "type": "string"
        }
      },
      "required": [
        "targetNeuron",
        "regulatorRef",
        "effects"
      ],
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "type": "object"
}
