{
  "$defs": {
    "localRef": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?![a-zA-Z][a-zA-Z0-9+.-]*://)[A-Za-z0-9._/-]+\\.ya?ml$",
      "type": "string"
    }
  },
  "$id": "https://brain-role.dev/schemas/v1alpha2/architecture.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "brain-role.dev/v1alpha2"
    },
    "compileOrder": {
      "$ref": "#/$defs/localRef"
    },
    "kind": {
      "const": "BrainArchitecture"
    },
    "layers": {
      "items": {
        "$ref": "#/$defs/localRef"
      },
      "maxItems": 7,
      "minItems": 7,
      "type": "array",
      "uniqueItems": true
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "architectureId": {
          "pattern": "^bra-[a-z0-9-]{3,60}$",
          "type": "string"
        },
        "classification": {
          "const": "PUBLIC"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9-]{2,63}$",
          "type": "string"
        },
        "version": {
          "pattern": "^0\\.1\\.[0-9]+$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "architectureId",
        "version",
        "classification"
      ],
      "type": "object"
    },
    "policies": {
      "items": {
        "$ref": "#/$defs/localRef"
      },
      "maxItems": 32,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "roles": {
      "items": {
        "$ref": "#/$defs/localRef"
      },
      "maxItems": 64,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "layers",
    "roles",
    "policies",
    "compileOrder"
  ],
  "title": "Brain Architecture",
  "type": "object"
}
