{
  "$id": "https://brain-role.dev/schemas/v1alpha2/plasticity-proposal.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "brain-role.dev/v1alpha2"
    },
    "kind": {
      "const": "PlasticityProposal"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "const": "PUBLIC"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "type": "string"
        },
        "version": {
          "pattern": "^0\\.2\\.[0-9]+$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "classification"
      ],
      "type": "object"
    },
    "spec": {
      "additionalProperties": false,
      "properties": {
        "change": {
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "number"
            },
            "parameter": {
              "const": "strength"
            },
            "to": {
              "type": "number"
            }
          },
          "required": [
            "parameter",
            "from",
            "to"
          ],
          "type": "object"
        },
        "evidence": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "rollback": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "targetSynapse": {
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "type": "string"
        }
      },
      "required": [
        "targetSynapse",
        "change",
        "evidence",
        "rollback"
      ],
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "type": "object"
}
