{
  "$id": "https://brain-role.dev/schemas/v1alpha2/clock.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "brain-role.dev/v1alpha2"
    },
    "kind": {
      "const": "ClockManifest"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "const": "PUBLIC"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "type": "string"
        },
        "version": {
          "pattern": "^0\\.2\\.[0-9]+$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "classification"
      ],
      "type": "object"
    },
    "spec": {
      "additionalProperties": false,
      "properties": {
        "periodTicks": {
          "maximum": 1000000,
          "minimum": 1,
          "type": "integer"
        },
        "phases": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "endExclusive": {
                "minimum": 1,
                "type": "integer"
              },
              "level": {
                "type": "number"
              },
              "name": {
                "pattern": "^[a-z][a-z0-9-]{0,63}$",
                "type": "string"
              },
              "regulatorRef": {
                "pattern": "^[a-z][a-z0-9-]{0,63}$",
                "type": "string"
              },
              "startInclusive": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "name",
              "startInclusive",
              "endExclusive"
            ],
            "type": "object"
          },
          "maxItems": 128,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "periodTicks",
        "phases"
      ],
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "type": "object"
}
