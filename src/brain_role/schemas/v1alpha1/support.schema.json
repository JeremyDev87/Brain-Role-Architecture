{
  "$id": "https://brain-role.dev/schemas/v1alpha1/support.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "brain-role.dev/v1alpha1"
    },
    "kind": {
      "const": "SupportManifest"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "const": "PUBLIC"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "type": "string"
        },
        "version": {
          "pattern": "^0\\.2\\.[0-9]+$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "classification"
      ],
      "type": "object"
    },
    "spec": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "items": {
            "enum": [
              "observe",
              "throttle",
              "retry",
              "quarantine-propose"
            ]
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "class": {
          "enum": [
            "environment",
            "transport",
            "anomaly",
            "barrier"
          ]
        },
        "targets": {
          "items": {
            "pattern": "^[a-z][a-z0-9-]{0,63}$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "class",
        "targets",
        "actions"
      ],
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "type": "object"
}
