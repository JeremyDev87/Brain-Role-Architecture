{
  "$id": "https://brain-role.dev/schemas/v1alpha1/compiled-connectome.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "brain-role.dev/v1alpha1"
    },
    "brainRole": {
      "additionalProperties": false,
      "properties": {
        "architectureId": {
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "architectureId",
        "sha256"
      ],
      "type": "object"
    },
    "clocks": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "homeostats": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "kind": {
      "const": "CompiledConnectome"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "const": "PUBLIC"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "type": "string"
        },
        "version": {
          "pattern": "^0\\.2\\.[0-9]+$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "classification"
      ],
      "type": "object"
    },
    "neurons": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "plasticityProposals": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "receptors": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "regulators": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "supports": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "synapses": {
      "items": {
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "brainRole",
    "neurons",
    "synapses",
    "regulators",
    "receptors",
    "homeostats",
    "supports",
    "clocks",
    "plasticityProposals"
  ],
  "type": "object"
}
